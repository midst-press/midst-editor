# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed

# Coverage directory used by tools like istanbul
coverage
.eslintcache

# Dependency directory
# https://www.npmjs.org/doc/misc/npm-faq.html#should-i-check-my-node_modules-folder-into-git
node_modules

# OSX
.DS_Store

release/app/dist
release/build
.erb/dll

.idea
npm-debug.log.*
*.css.d.ts
*.sass.d.ts
*.scss.d.ts

# eslint ignores hidden directories by default:
# https://github.com/eslint/eslint/issues/8429
!.erb

src/renderer/index.ejs

# `!.erb` above un-ignores every path segment named .erb, at any depth -- including the generated
# release/app/.erb that the e2e harness populates. Build output is not ours to lint.
release/app/.erb

# The vendored midst-format build is byte-exact and checked by tools/check-vendored-format.mjs; not ours to lint.
vendor/midst-format
