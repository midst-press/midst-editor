#!/bin/bash
# Runs as root before the new Midst is written to /Applications (issue 16).
#
# Any Midst already in /Applications is kept, renamed with its own version number, so the new one
# can be installed as "Midst" without writing over it: "Midst.app" becomes "Midst <version>.app"
# and "Midst Beta.app" becomes "Midst Beta <version>.app", whatever is inside them, including our
# own releases at any version, even the one being installed. Nothing is ever written over without
# the poet's say: keeping an app is recoverable and writing over it is not (Stuart, 4 Nov: the most
# conservative reading wherever data safety is a judgement call).
#
# The version (CFBundleShortVersionString) goes into a file name, so it is used only if it matches
# ^[0-9][0-9A-Za-z.+-]*$. Otherwise, or if it cannot be read, the app is kept under
# UNKNOWN_VERSION_NAME ("Midst (version unknown).app"). A name already taken gets " (2)",
# " (3)" ... " (99)"; with none of those free the script fails.
#
# Each app renamed is written, one path per line, to $INSTALLER_TEMP/press.Midst.previous-apps.
# The opt-in "Delete the Midst that's already installed" choice deletes exactly those paths, and nothing
# else, after the new app is installed.
#
# If anything here fails, the script exits 1 and the installer stops before the new app is
# written. It never deletes anything, and never moves an app onto an existing name.
#
# $3 is the target volume. MIDST_PREVIOUS_RECORD overrides the record path for the tests.
set -u

say() { echo "Midst preinstall: $*"; }
fail() { echo "Midst preinstall: FAILED: $*" >&2; exit 1; }

apps="${3%/}/Applications"
record="${MIDST_PREVIOUS_RECORD:-${INSTALLER_TEMP:-}/press.Midst.previous-apps}"

# Create the record before anything moves, so a record we cannot write stops the install while
# every app is still where it was.
#
# macOS Installer runs this script twice in one install, in the same sandbox and with the same
# INSTALLER_TEMP (#353: the 0.9.0 candidate's install.log). INSTALLER_TEMP is new for each install.
# Nothing documents whether the second run comes before or after the new app is written. If it
# came after, it would find the new Midst.app, rename it aside as a kept older copy, and a ticked
# delete would then delete the new install (#397). So only the first run in an install acts. When
# it has kept everything it writes a completion marker beside the record; a run that finds the
# marker does nothing at all. A record WITHOUT the marker means an earlier run in this install
# stopped part-way, so this run refuses rather than treat it as done: an app it did not get to
# would otherwise be written over (alden-ec2221c7, #397). The record is never emptied: emptying it
# lost what the first run kept, and the ticked delete then deleted nothing (#353).
[ -n "${MIDST_PREVIOUS_RECORD:-}${INSTALLER_TEMP:-}" ] || fail "INSTALLER_TEMP is not set, so the apps kept could not be recorded"
done_marker="$record.done"
if [ -e "$done_marker" ] || [ -L "$done_marker" ]; then
  [ -f "$done_marker" ] && [ ! -L "$done_marker" ] || fail "$done_marker exists but is not a plain file"
  say "already ran to completion in this install ($done_marker exists); renaming nothing"
  exit 0
fi
if [ -e "$record" ] || [ -L "$record" ]; then
  [ -f "$record" ] && [ ! -L "$record" ] || fail "$record exists but is not a plain file"
  fail "$record exists but an earlier run in this install did not finish; refusing to continue"
fi
: > "$record" || fail "could not create $record"
[ -f "$record" ] && [ -w "$record" ] || fail "cannot write $record"

UNKNOWN_VERSION_NAME="Midst (version unknown)"

version_of() { # <app>: prints its version if it is safe in a file name, or fails
  local v
  v=$(plutil -extract CFBundleShortVersionString raw -o - "$1/Contents/Info.plist" 2> /dev/null) || return 1
  [[ "$v" =~ ^[0-9][0-9A-Za-z.+-]*$ ]] || return 1
  echo "$v"
}

kept_stem() { # <app> <"Midst" or "Midst Beta">: prints the name it is kept under, without ".app"
  local v
  if v=$(version_of "$1"); then echo "$2 $v"; else echo "$UNKNOWN_VERSION_NAME"; fi
}

free_name() { # <stem>: prints the first unused "<stem>.app", "<stem> (2).app" ... "<stem> (99).app"
  local n=1 name="$apps/$1.app"
  while [ -e "$name" ] || [ -L "$name" ]; do
    n=$((n + 1))
    [ "$n" -le 99 ] || return 1
    name="$apps/$1 ($n).app"
  done
  echo "$name"
}

keep() { # <app> <"Midst" or "Midst Beta">: renames it aside and records the new path
  local stem to
  stem=$(kept_stem "$1" "$2")
  to=$(free_name "$stem") || fail "no free name for $1: \"$stem.app\" and \"$stem (2..99).app\" are all taken"
  mv -- "$1" "$to" || fail "could not rename $1 to $to"
  if ! { [ -e "$to" ] || [ -L "$to" ]; } || [ -e "$1" ] || [ -L "$1" ]; then
    fail "renaming $1 to $to did not take effect"
  fi
  printf '%s\n' "$to" >> "$record" || fail "renamed $1 to $to, but could not record it"
  say "kept the older $(basename "$1") as $(basename "$to")"
}

beta="$apps/Midst Beta.app"
if [ -e "$beta" ] || [ -L "$beta" ]; then keep "$beta" "Midst Beta"; fi

current="$apps/Midst.app"
if [ -e "$current" ] || [ -L "$current" ]; then keep "$current" Midst; fi

# Only now is this install's preservation complete.
: > "$done_marker" || fail "kept everything, but could not write $done_marker"
exit 0
